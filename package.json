{
  "name": "ai-support-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@11.15.0",
  "scripts": {
    "prepare": "husky",
    "dev": "wxt",
    "build": "wxt build && node tests/build/validate-output.mjs",
    "build:native-dev": "wxt build --mode native-dev && node tests/build/validate-output.mjs --mode native-dev",
    "benchmark:snippet-delivery": "node tests/performance/run-snippet-delivery-benchmark.mjs",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --ignore-unknown .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:list": "playwright test --list",
    "validate": "pnpm lint && pnpm format --check && pnpm typecheck && pnpm test && pnpm exec playwright test --list && pnpm build"
  },
  "dependencies": {
    "@tiptap/pm": "3.29.2",
    "@tiptap/react": "3.29.2",
    "@tiptap/starter-kit": "3.29.2",
    "dexie": "^4.4.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@wxt-dev/module-react": "^1.2.2",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.5",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.5",
    "rollup": "^4.62.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "wxt": "^0.20.27"
  }
}
